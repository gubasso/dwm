root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = tab
tab_width = 8

[Makefile]
indent_style = tab
tab_width = 8

[*.mk]
indent_style = tab
tab_width = 8

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.diff]
trim_trailing_whitespace = false
insert_final_newline = false
